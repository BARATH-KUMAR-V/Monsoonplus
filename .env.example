# monsoonplus - optional credentials
#
# Copy this file to `.env` in the SAME directory (the repository root) and fill in
# what you have. Every value here is optional: with an empty .env, or no .env at all,
# the project still runs end to end in Dataset mode.
#
#   cp .env.example .env
#
# `.env` is listed in .gitignore and must never be committed.

# --- TomTom: live traffic for Live mode ---------------------------------------
# Free tier, no credit card. Register at https://developer.tomtom.com, create an app,
# copy the key here. Without it the collector records weather and predictions only,
# and labels traffic "not_configured".
TOMTOM_API_KEY=

# --- Open-Meteo: weather ------------------------------------------------------
# NO KEY NEEDED. Open-Meteo is free and keyless for non-commercial use.
# There is deliberately no variable here. If you ever find code asking for one,
# that is a bug.

# --- Google Earth Engine: real Sentinel-2 NDWI --------------------------------
# Optional. Authenticate with `earthengine authenticate` instead of a key here;
# set the project id if your account needs one. See README section 7.
EARTHENGINE_PROJECT=

# --- frontend -----------------------------------------------------------------
# Where the frontend looks for the optional local backend. Only change this if you
# run uvicorn on a different port.
VITE_MONSOONPLUS_API=http://127.0.0.1:8000
